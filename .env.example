# Local development defaults
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/brick_builder
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
APP_ORIGIN=http://127.0.0.1:5173
THUMBNAIL_STORAGE_DRIVER=local
THUMBNAIL_DIRECTORY=.dev-data/thumbnails

# Vercel Preview / Production
# Configure the following values in Vercel Project Settings.
# Never commit real credentials or copy these placeholders unchanged.
# DATABASE_URL=postgres://<user>:<password>@<neon-host>/<database>?sslmode=require
# SESSION_SECRET=generate-a-different-secret-for-each-environment
# APP_ORIGIN=https://<your-domain>
# THUMBNAIL_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=<private-bucket-name>
# S3_ACCESS_KEY_ID=<access-key-id>
# S3_SECRET_ACCESS_KEY=<secret-access-key>
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=true
